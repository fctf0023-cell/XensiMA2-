end

local function toggle(parent, text, y, key)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -10, 0, 38)
    button.Position = UDim2.fromOffset(5, y)
    button.BackgroundColor3 = Color3.fromRGB(25, 28, 40)
    button.TextColor3 = Color3.fromRGB(190, 195, 210)
    button.TextSize = 10
    button.Font = Enum.Font.GothamSemibold
    button.Parent = parent

    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 8)

    local function refresh()
        if Settings[key] then
            button.BackgroundColor3 = Color3.fromRGB(0, 150, 90)
            button.Text = text .. "    ON"
            button.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            button.BackgroundColor3 = Color3.fromRGB(25, 28, 40)
            button.Text = text .. "    OFF"
            button.TextColor3 = Color3.fromRGB(180, 185, 200)
        end
    end

    button.Activated:Connect(function()
        Settings[key] = not Settings[key]
        refresh()
    end)

    refresh()

    return button
end

local function inputBox(parent, labelText, y, defaultText, callback)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.55, 0, 0, 30)
    label.Position = UDim2.fromOffset(5, y)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = Color3.fromRGB(180, 185, 200)
    label.TextSize = 10
    label.Font = Enum.Font.GothamSemibold
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = parent

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0.4, -5, 0, 30)
    box.Position = UDim2.new(0.6, 0, 0, y)
    box.BackgroundColor3 = Color3.fromRGB(25, 28, 40)
    box.TextColor3 = Color3.fromRGB(230, 235, 240)
    box.Text = tostring(defaultText)
    box.TextSize = 10
    box.Font = Enum.Font.GothamSemibold
    box.ClearTextOnFocus = false
    box.Parent = parent

    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 7)

    box.FocusLost:Connect(function()
        callback(box.Text)
    end)

    return box
end

