local Tabs = {}
local Pages = {}

local function createTab(name, icon, y)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -12, 0, 45)
    button.Position = UDim2.fromOffset(6, y)
    button.BackgroundColor3 = Color3.fromRGB(25, 28, 40)
    button.Text = icon .. "  " .. name
    button.TextColor3 = Color3.fromRGB(160, 170, 190)
    button.TextSize = 10
    button.Font = Enum.Font.GothamBold
    button.Parent = Sidebar

    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 9)

    Tabs[name] = button

    return button
end

local function createPage()
    local page = Instance.new("Frame")
    page.Size = UDim2.fromScale(1, 1)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.Parent = Content

    table.insert(Pages, page)

    return page
end

local function selectTab(name)
    for _, page in ipairs(Pages) do
        page.Visible = false
    end

    for tabName, button in pairs(Tabs) do
        button.BackgroundColor3 =
            tabName == name
            and Color3.fromRGB(0, 150, 90)
            or Color3.fromRGB(25, 28, 40)

        button.TextColor3 =
            tabName == name
            and Color3.fromRGB(255, 255, 255)
            or Color3.fromRGB(160, 170, 190)
    end

    local page = Pages[
        name == "ESP" and 1 or
        name == "Target" and 2 or
        3
    ]

    if page then
        page.Visible = true
    end
end

