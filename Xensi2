--==============================================================
-- TARGET
--==============================================================

local CurrentTarget = nil

local function passesFilter(npc)

    if Settings.Filter == "" then
        return true
    end

    return string.find(
        string.lower(npc.Name),
        Settings.Filter,
        1,
        true
    ) ~= nil
end

local function getRoot(npc)
    return npc:FindFirstChild("HumanoidRootPart")
        or npc.PrimaryPart
        or npc:FindFirstChild("Head")
end

--==============================================================
-- MAIN UPDATE
--==============================================================

local timer = 0

RunService.RenderStepped:Connect(function(dt)

    local camera = workspace.CurrentCamera
    if not camera then
        return
    end

    -- FOV
    local viewport = camera.ViewportSize

    FOV.Size = UDim2.fromOffset(
        Settings.FOVRadius * 2,
        Settings.FOVRadius * 2
    )

    FOV.Position = UDim2.fromOffset(
        viewport.X / 2,
        viewport.Y / 2
    )

    FOV.Visible = Settings.FOV

    timer += dt

    if timer < Settings.UpdateRate then
        return
    end

    timer = 0

    local character = LocalPlayer.Character
    local localRoot =
        character and character:FindFirstChild("HumanoidRootPart")

    if not localRoot then
        return
    end

    local center = Vector2.new(
        viewport.X / 2,
        viewport.Y / 2
    )

    local closest = nil
    local closestScreenDistance = Settings.FOVRadius

    local visibleCount = 0
    local espIndex = 0

    for npc in pairs(NPCs) do

        if not npc.Parent then
            removeNPC(npc)
            continue
        end

        local humanoid = npc:FindFirstChildOfClass("Humanoid")
        local head = npc:FindFirstChild("Head")
        local root = getRoot(npc)

        if not humanoid or humanoid.Health <= 0 or not head or not root then
            continue
        end

        if not passesFilter(npc) then
            continue
        end

        local distance =
            (localRoot.Position - root.Position).Magnitude

        if distance > Settings.MaxDistance then
            continue
        end
